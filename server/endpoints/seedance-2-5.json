{
  "kind": "declarative",
  "modality": "video",
  "schema_version": "1.0.0",
  "meta": {
    "title": "Seedance 视频生成",
    "docs": "https://docs.volcengine.com/docs/ark/create-video-generation-task-api",
    "hints": { "base_url": "https://ark.cn-beijing.volces.com" },
    "notes": "三款型号走同一个接口，只有档位不同：2.5 时长到 30 秒、没有 4K，且首帧任务只认 adaptive 画幅——指定具体比例会报错，所以它的 aspect_ratios 只留 adaptive，让项目画幅对不上、不发 ratio；2.0 系列时长到 15 秒、首帧可以指定画幅，其中 fast 只出到 720p。generate_audio 显式关掉，音轨走配音端点。"
  },
  "auth": {
    "headers": { "Authorization": "Bearer {{ api_key }}" }
  },
  "inputs": {
    "first_frame": { "source": "start_image", "encoding": "data_uri" }
  },
  "defaults": {
    "model": "doubao-seedance-2-5-260628",
    "resolution": "720p",
    "duration": 5
  },
  "submit": {
    "method": "POST",
    "url": "{{ base_url }}/api/v3/contents/generations/tasks",
    "headers": { "Content-Type": "application/json" },
    "body": {
      "model": "{{ model }}",
      "content": [
        { "type": "text", "text": "{{ prompt }}" },
        {
          "$when": "inputs.first_frame",
          "type": "image_url",
          "image_url": { "url": "{{ inputs.first_frame }}" },
          "role": "first_frame"
        }
      ],
      "resolution": "{{ resolution }}",
      "ratio": "{{ aspect_ratio }}",
      "duration": "{{ duration }}",
      "seed": "{{ seed }}",
      "generate_audio": false
    },
    "extract": {
      "task_id": ["$.id"],
      "error": ["$.error.message", "$.message"]
    }
  },
  "poll": {
    "method": "GET",
    "url": "{{ base_url }}/api/v3/contents/generations/tasks/{{ task_id }}",
    "extract": {
      "status": ["$.status"],
      "video_url": ["$.content.video_url"],
      "error": ["$.error.message"]
    }
  },
  "status_map": {
    "queued": "queued",
    "running": "running",
    "succeeded": "succeeded",
    "failed": "failed",
    "cancelled": "failed",
    "expired": "failed"
  },
  "capabilities": {
    "start_image": "yes",
    "durations": { "min": 4, "max": 30 },
    "resolutions": ["480p", "720p", "1080p"],
    "aspect_ratios": ["adaptive"],
    "models": ["doubao-seedance-2-5-260628", "doubao-seedance-2-0-260128", "doubao-seedance-2-0-fast-260128"],
    "by_model": {
      "doubao-seedance-2-0-260128": {
        "durations": { "min": 4, "max": 15 },
        "resolutions": ["480p", "720p", "1080p", "4k"],
        "aspect_ratios": ["adaptive", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"]
      },
      "doubao-seedance-2-0-fast-260128": {
        "durations": { "min": 4, "max": 15 },
        "resolutions": ["480p", "720p"],
        "aspect_ratios": ["adaptive", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"]
      }
    }
  }
}
